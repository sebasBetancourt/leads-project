# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Base de datos (docker-compose la crea con estos valores) ---
POSTGRES_USER=leadbot
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=leadbot
DATABASE_URL=postgresql+psycopg://leadbot:cambia-esto@localhost:5432/leadbot

# --- Google Maps scraper (servicio gosom en docker-compose) ---
GMAPS_SCRAPER_URL=http://localhost:8080

# --- IA (LiteLLM: cambia de proveedor solo cambiando LLM_MODEL) ---
# Proveedor por defecto: Groq (https://console.groq.com/keys).
# Ejemplos: groq/openai/gpt-oss-120b | groq/llama-3.3-70b-versatile | anthropic/claude-sonnet-5-5 | ollama/llama3.1
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=
# Opcional: un modelo distinto por tarea del agente (vacío = LLM_MODEL).
LLM_MODEL_QUALIFY=
LLM_MODEL_DRAFT=
# schema: salida estructurada estricta (gpt-oss, Claude, OpenAI). json_object: para modelos que solo
# soportan modo JSON (llama-3.3-70b-versatile, Ollama).
LLM_JSON_MODE=schema
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Búsqueda web para el agente (tools/web_search.py) ---
# duckduckgo (gratis, sin key) | serpapi
WEB_SEARCH_PROVIDER=duckduckgo
SERPAPI_API_KEY=

# --- Google Sheets (interfaz del MVP) ---
# JSON de una cuenta de servicio de Google Cloud, compartiendo la hoja con su correo
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
GOOGLE_SHEET_ID=

# --- Email (Gmail con contraseña de aplicación) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=Sebastian Betancourt - BrainSol

# --- Interruptores de emergencia (true = pausa ese canal) ---
PAUSE_ALL=false
PAUSE_EMAIL=false
PAUSE_WHATSAPP=false
PAUSE_INSTAGRAM=false
PAUSE_FACEBOOK=false
PAUSE_LINKEDIN=false
